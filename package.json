{
  "name": "jarvis-os",
  "version": "0.1.0",
  "private": true,
  "description": "JARVIS OS — Phase 1: Foundation & Core Architecture.",
  "workspaces": [
    "packages/*",
    "packages/agents/*",
    "packages/tools/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "node --require tsx/cjs --test packages/*/tests/*.test.ts packages/*/*/tests/*.test.ts apps/*/tests/*.test.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cli": "node apps/cli/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "eslint": "^9.9.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "prettier": "^3.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
